<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>voltage</AssemblyName>
		<RootNamespace>Voltage.Cli</RootNamespace>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<RollForward>LatestMajor</RollForward>
		<Version>0.2.1</Version>
		<Configurations>Editor-Debug;Editor-Release</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Editor-Debug'">
		<Optimize>false</Optimize>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Editor-Release'">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<!-- .mcp.json runs this copy, so a long-lived MCP server never locks the build output; a locked copy only delays the refresh. -->
	<Target Name="CopyForMcp" AfterTargets="Build" Condition="'$(Configuration)' == 'Editor-Debug'">
		<ItemGroup>
			<McpFiles Include="$(OutDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(McpFiles)" DestinationFiles="@(McpFiles->'$(MSBuildProjectDirectory)\bin\mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" Retries="0" />
	</Target>

</Project>
