{
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "Bash(git push:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-attribution.py\"",
            "timeout": 10,
            "statusMessage": "Checking git command for attribution"
          }
        ]
      }
    ]
  }
}
